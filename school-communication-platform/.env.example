NODE_ENV=production
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
DATABASE_PATH=backend/data/school.db
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=15
# Per-user document storage quota (MB). Default 250.
UPLOAD_QUOTA_MB=250
# Optional antivirus: set CLAMAV_BIN=clamdscan (or CLAMAV_HOST=host) to scan
# every upload. Without an engine files are checked for executables/scripts.
#CLAMAV_BIN=clamdscan
#CLAMAV_HOST=127.0.0.1
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
STRONG_PASSWORDS=true
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15MIN=20
SEED_DEMO_DATA=true
