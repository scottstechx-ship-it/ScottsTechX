NODE_ENV=production
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# ---- STORAGE -------------------------------------------------------------
# ONE folder holds everything the school edits: users, messages, news,
# gallery, documents, fees and settings.
#   <DATA_DIR>/school.db    the database
#   <DATA_DIR>/uploads      every uploaded file
#   <DATA_DIR>/backups      rolling snapshots (npm run backup / restore)
#
# Leave DATA_DIR unset to auto-detect:
#   * a writable mount at /var/data, /data or /mnt/data wins (an older
#     in-repo database is carried across automatically, once), otherwise
#   * backend/data inside the project is used.
# Set it explicitly on any host with a persistent volume.
DATA_DIR=/var/data
# Fine-grained overrides (rarely needed; they beat DATA_DIR):
# DATABASE_PATH=/var/data/school.db
# UPLOAD_DIR=/var/data/uploads

# ---- BACKUPS -------------------------------------------------------------
BACKUP_KEEP=14
BACKUP_EVERY_HOURS=6
AUTO_BACKUP=true

MAX_FILE_SIZE_MB=15
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
STRONG_PASSWORDS=true
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15MIN=20
SEED_DEMO_DATA=true
