# ───────────────────────────────────────────────────────────────
# Kalinabiri Secondary School — Frontend deploy config
# Copy this file to ".env" and fill in real values.
# .env is git-ignored. NEVER commit .env.
# ───────────────────────────────────────────────────────────────

# Netlify Personal Access Token (NOT a deploy ID)
# Get one at: https://app.netlify.com/user/applications#personal-access-tokens
# Required scopes: Deploy / Build
NETLIFY_TOKEN=

# Netlify site UUID for kalibz-international
# Found at: https://app.netlify.com/sites/<your-site>/settings/general
NETLIFY_SITE_ID=
