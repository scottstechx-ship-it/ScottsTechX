{
  "name": "school-communication-platform",
  "version": "1.0.0",
  "description": "Five connected dashboards (Super Admin, Admin, Teacher, Student, Parent) for school communication: messaging, documents, announcements and notifications. REST API + SQLite + Socket.IO.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "seed": "node backend/database/seed.js --reset",
    "test": "node --test tests/api.test.js && node tests/frontend.smoke.js",
    "smoke": "node tests/frontend.smoke.js"
  },
  "keywords": [
    "school",
    "management",
    "messaging",
    "documents",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "officeparser": "^7.5.1",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "socket.io-client": "^4.8.3"
  }
}
